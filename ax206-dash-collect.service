[Unit]
Description=Metrik-Collector fuer das AX206-Dashboard (lcd4linux)
Documentation=file:///etc/lcd4linux/README-ax206-dashboard.md
# lcd4linux liest /run/lcd4linux/metrics - ohne diesen Dienst bleiben die
# Felder fuer Kern-Last, Dienste-Ampeln, GPU und Wetter leer.
Before=lcd4linux-ax206.service

[Service]
Type=simple
ExecStart=/usr/local/bin/ax206-dash-collect.py eth0
Restart=always
RestartSec=5
Nice=10
IOSchedulingClass=idle

# /run ist tmpfs und nach jedem Boot leer. Das Verzeichnis deshalb von
# systemd anlegen lassen, nicht per ExecStartPre=mkdir: ReadWritePaths gilt
# auch fuer ExecStartPre, und dessen Mount-Namespace scheitert an einem Pfad,
# den erst dieser Aufruf erzeugen soll (Fehler 226/NAMESPACE, Endlos-Restart).
# RuntimeDirectory laeuft vor dem Namespace und macht den Pfad beschreibbar.
RuntimeDirectory=lcd4linux
RuntimeDirectoryMode=0755
# Beim Neustart des Collectors stehenlassen, sonst greift lcd4linux waehrend
# der Luecke ins Leere.
RuntimeDirectoryPreserve=yes

# Der Collector liest nur /proc, /sys und ruft ein paar Kommandos auf.
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=read-only
PrivateTmp=true

[Install]
WantedBy=multi-user.target
